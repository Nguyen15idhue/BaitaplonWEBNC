MYSQL_DATABASE=travela
MYSQL_USER=travela
MYSQL_PASSWORD=travela_password
MYSQL_ROOT_PASSWORD=root_password
# JWT tối thiểu 32 ký tự. Production thiếu/ngắn -> backend từ chối khởi động (fail-fast).
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
# Môi trường backend: Development (demo) hoặc Production (Swagger tắt, secret bắt buộc).
ASPNETCORE_ENVIRONMENT=Development
# Cổng host thực tế trên máy dev: MySQL 3307 (3306 bị app khác chiếm), backend 5000, FE 3001.
